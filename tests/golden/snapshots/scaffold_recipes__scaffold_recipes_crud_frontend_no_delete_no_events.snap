=== app/src/hooks/use-post.ts ===
import { useMutation, useQuery } from "@tanstack/react-query";

type RpcFn = (input?: unknown) => Promise<unknown>;

export function usePost(address?: string) {
  return useQuery({
    queryKey: ["sunscreen", "post", address],
    enabled: Boolean(address),
    queryFn: async () => ({ address }),
  });
}

export function useCreatePost(rpc?: RpcFn) {
  return useMutation({
    mutationKey: ["sunscreen", "create", "post"],
    mutationFn: async (input?: unknown) => (rpc ? rpc(input) : input),
  });
}

export function useUpdatePost(rpc?: RpcFn) {
  return useMutation({
    mutationKey: ["sunscreen", "update", "post"],
    mutationFn: async (input?: unknown) => (rpc ? rpc(input) : input),
  });
}

export const postRecipe = { resource: "post", hook: "usePost" } as const;
