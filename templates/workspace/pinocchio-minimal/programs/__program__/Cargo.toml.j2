[package]
name = "{{ program_name | snake_case }}"
version = "0.1.0"
description = "Pinocchio program for {{ project_name }}"
edition = "{{ rust_edition }}"

[lib]
crate-type = ["cdylib", "lib"]
name = "{{ program_name | snake_case }}"

[features]
default = []
no-entrypoint = []

[dependencies]
pinocchio = { version = "{{ pinocchio_version }}", default-features = false }
