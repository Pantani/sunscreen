=== sunscreen.yml ===
version: 1
project:
  name: my-dapp
  description: "MyDapp — Solana workspace scaffolded by sunscreen"
  framework: anchor
  anchor_version: "0.30.1"
  solana_version: "1.18.18"
  rust_edition: "2021"
toolchain:
  required:
    anchor: "0.30.1"
    solana: "1.18.18"
    rustc: "1.79.0"
    node: "20.0.0"
scaffolding:
  default_template: workspace/anchor-multiple
programs:
  - name: my-dapp
    path: programs/my_dapp
workspace:
  frontend: next
=== tests/my-dapp.ts ===
import * as anchor from "@coral-xyz/anchor";
import { Program } from "@coral-xyz/anchor";
import { MyDapp } from "../target/types/my_dapp";

describe("my-dapp", () => {
  // Configure the client to use the local cluster.
  anchor.setProvider(anchor.AnchorProvider.env());

  const program = anchor.workspace.MyDapp as Program<MyDapp>;

  it("loads the program", () => {
    // Scaffold an instruction with `sunscreen scaffold instruction <name> --program my_dapp`,
    // then replace this with a real `program.methods.<name>(...).rpc()` call.
    if (!program) throw new Error("program not loaded");
  });
});
