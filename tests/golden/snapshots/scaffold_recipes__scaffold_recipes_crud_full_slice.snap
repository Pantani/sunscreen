=== tests/blog_app/post.test.ts ===
import * as anchor from "@coral-xyz/anchor";

describe("post recipe", () => {
  anchor.setProvider(anchor.AnchorProvider.env());

  const program = anchor.workspace[Object.keys(anchor.workspace)[0]];

  function expectMethod(name: string) {
    if (!program?.methods?.[name]) throw new Error(`missing ${name} method`);
  }

  it("exposes generated CRUD methods", () => {
    expectMethod("createPost");
    expectMethod("readPost");
    expectMethod("updatePost");
    expectMethod("deletePost");
  });
});
