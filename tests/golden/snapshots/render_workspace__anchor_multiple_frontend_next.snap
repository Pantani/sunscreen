export const metadata = {
  title: "sunscreen app",
  description: "Generated by sunscreen",
};

export default function RootLayout({
  children,
}: {
  children: React.ReactNode;
}) {
  return (
    <html lang="en">
      <body>{children}</body>
    </html>
  );
}
