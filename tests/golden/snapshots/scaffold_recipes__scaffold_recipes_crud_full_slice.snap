    title: String,
    body: String,
) -> Result<()> {
    let _ = ctx;
    let _ = &authority;
    let _ = &title;
    let _ = &body;
    emit!(PostCreated {
        resource: todo!("set PostCreated.resource"),
    });
    Ok(())
}
